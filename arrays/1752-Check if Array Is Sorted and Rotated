class Solution {
public:
    bool check(vector<int>& nums) {
        
        vector<int> s=nums;
        sort(s.begin(),s.end());
         vector<int> doubled=s;
        doubled.insert(doubled.end(),s.begin(),s.end());
       

        auto it=search(doubled.begin(),doubled.end(),nums.begin(),nums.end());
        if(it==doubled.end()){
            return false;
        }
        return true;

        
    }
};
